\begin{tikzpicture}[scale=0.75]
    \newcommand*{\defcoords}{
        \coordinate (p0) at (1.5, 1){};
        \coordinate (p1) at (1, 0){};
        \coordinate (p2) at (3, 0){};
        \coordinate (p3) at (2, 2){};
        \coordinate (p4) at (0, 2){};

        \node[scale=0.6] at ($(p1)!0.5!(p2)$) (p12) {a};
        \node[scale=0.6] at ($(p2)!0.5!(p3)$) (p23) {b};
        \node[scale=0.6] at ($(p3)!0.5!(p4)$) (p34) {c};
        \node[scale=0.6] at ($(p4)!0.5!(p1)$) (p41) {d};
    }

    \begin{scope}[
        very thick,
        decoration={markings, mark=at position 0.75 with {\arrow{>}}}
    ]
        \defcoords
        \draw[postaction={decorate}] (p1) -- (p12) -- (p2);
        \draw[postaction={decorate}] (p2) -- (p23) -- (p3);
        \draw[postaction={decorate}] (p3) -- (p34) -- (p4);
        \draw[postaction={decorate}] (p4) -- (p41) -- (p1);

        \node[] at (1.5, 1){A};

        \foreach \p in {p1, p2, p3, p4} {
            \filldraw (\p) circle (2pt);
        }
    \end{scope}

    \begin{scope}[
        very thick,
        shift={(4, 0)},
        decoration={markings, mark=at position 0.75 with {\arrow{>}}}
    ]
        \defcoords
        \draw[postaction={decorate}] (p1) -- (p12) -- (p2);
        \draw[postaction={decorate}] (p2) -- (p23) -- (p3);
        \draw[postaction={decorate}] (p3) -- (p34) -- (p4);
        \draw[postaction={decorate}] (p4) -- (p41) -- (p1);

        \node[scale=0.6] at ($(p0)!0.4!(p1)$) (p01) {e};
        \node[scale=0.6] at ($(p0)!0.4!(p2)$) (p02) {f};
        \node[scale=0.6] at ($(p0)!0.4!(p3)$) (p03) {g};
        \node[scale=0.6] at ($(p0)!0.4!(p4)$) (p04) {h};

        \draw[postaction={decorate}] (p0) -- (p02) -- (p2);
        \draw[postaction={decorate}] (p0) -- (p03) -- (p3);
        \draw[postaction={decorate}] (p0) -- (p04) -- (p4);
        \draw[postaction={decorate}] (p0) -- (p01) -- (p1);

        \node[scale=0.75] at (1.75, 0.35) {A};
        \node[scale=0.75] at (2, 1.15) {B};
        \node[scale=0.75] at (1.25, 1.65) {C};
        \node[scale=0.75] at (1.0, 0.85) {D};

        \foreach \p in {p0, p1, p2, p3, p4} {
            \filldraw (\p) circle (2pt);
        }
    \end{scope}
\end{tikzpicture}

